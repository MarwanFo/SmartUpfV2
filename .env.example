# ── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
API_PREFIX=api

# ── PostgreSQL (LOCAL — not Docker) ──────────────────────
DATABASE_URL="postgresql://smartupf_user:smartupf_pass@localhost:5432/smartupf_dev"
DATABASE_TEST_URL="postgresql://smartupf_user:smartupf_pass@localhost:5432/smartupf_test"

# ── Redis (Docker) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_random_32_char_string_access
JWT_REFRESH_SECRET=change_this_to_random_32_char_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Gemini AI ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Email (SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SMART UPF <noreply@smartupf.com>"

# ── File Upload ───────────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=pdf,doc,docx,png,jpg,jpeg

# ── MFA ───────────────────────────────────────────────────
MFA_APP_NAME=SMART_UPF
MFA_ISSUER=SmartUPF

# ── Rate Limiting ─────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
